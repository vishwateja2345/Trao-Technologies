# Copy this file to .env and fill in real values for local development.
# The batch entry point (`npm run evaluate`) needs NONE of this beyond
# an LLM_PROVIDER/OPENROUTER_API_KEY if you want real (non-mock) generation —
# it never touches MongoDB.

# --- Server ---
NODE_ENV=development
PORT=4000
# Origin(s) allowed to call the API directly (comma-separated). Not needed
# when the frontend proxies /api/* through Next.js (see web/next.config.ts),
# but kept as a safety net for direct API access.
CORS_ORIGIN=http://localhost:3000

# --- Database ---
# Local dev: run `docker run -d -p 27017:27017 mongo:7` and use the default below.
# Production: a MongoDB Atlas free-tier connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/ai-interview-prep-kit

# --- Auth ---
# Any long random string. MUST be changed before deploying to production —
# the server refuses to start in production with the placeholder default.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- LLM provider ---
# "mock" (default) needs no key at all and runs the full pipeline with
# deterministic, template-based content in place of real model calls — useful
# for local development, CI, and exercising the batch entry point without
# burning any quota. Set to "deepseek" or "openrouter" + a real key for
# actual generation quality (required for the deployed/submitted app).
# Both are OpenAI-compatible chat-completions APIs handled by the same
# client (see services/generation/openAICompatibleClient.ts).
LLM_PROVIDER=mock

# Option A: DeepSeek (https://platform.deepseek.com) — very low cost,
# fast, high-quality output. Requires a small prepaid balance (not a
# metered free tier), so it is offered as an equally-supported
# alternative to OpenRouter rather than the default.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Option B: OpenRouter (https://openrouter.ai/keys) — genuinely free,
# no card required. Free-tier models are shared-pool and can return 429
# "temporarily rate-limited upstream" under load; the client retries
# with backoff and honours Retry-After, and falls back to deterministic
# heuristic content if a call keeps failing rather than breaking the run.
# Check https://openrouter.ai/models?max_price=0 for the current list —
# it changes over time as providers rotate free capacity in and out.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Retrieval / security ---
# Only ever set this to true for local development or when running the
# batch entry point against a local fixture server (Section 9 of the brief).
# It permits fetching localhost/127.0.0.1 ONLY — all other private/link-local
# ranges (10/8, 172.16/12, 192.168/16, 169.254/16) remain blocked regardless.
ALLOW_PRIVATE_HOSTS=false
CRAWL_MAX_PAGES=6
CRAWL_TIMEOUT_MS=8000
CRAWL_MAX_BYTES=1500000

# --- Generation tuning ---
MAX_COVERAGE_PASSES=2
LLM_MAX_RETRIES=4
LLM_MIN_INTERVAL_MS=1500
